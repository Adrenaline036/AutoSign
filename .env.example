AUTOSIGN_ENVIRONMENT=development
AUTOSIGN_HOST=0.0.0.0
AUTOSIGN_PORT=8000
AUTOSIGN_DATA_DIR=./data
AUTOSIGN_LOG_LEVEL=INFO
# SQLite 写锁冲突时的最大等待时间；不是每次请求的固定延迟。
AUTOSIGN_DATABASE_BUSY_TIMEOUT_MS=2000
# Docker 通过 Xvfb 运行有界面 Chromium；本地开发可保留 true。
AUTOSIGN_BROWSER_HEADLESS=true
AUTOSIGN_BROWSER_HIDE_WINDOW=false
# false 且未配置原生 Chrome 时会启用已弃用的截图轮询兼容模式；新部署优先使用
# 官方 Docker Compose 的 noVNC，或在桌面环境配置原生 Chrome 窗口。
AUTOSIGN_BROWSER_LIVE_ENABLED=false
# 桌面原生窗口模式需要同时设置本机 Chrome/Chromium 可执行文件的绝对路径。
# AUTOSIGN_BROWSER_NATIVE_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# AUTOSIGN_BROWSER_NATIVE_WINDOW=true
# 交互登录会话闲置 15 分钟后过期；后台每 60 秒主动清理。
AUTOSIGN_BROWSER_SESSION_TIMEOUT_SECONDS=900
AUTOSIGN_BROWSER_SESSION_CLEANUP_POLL_SECONDS=60
# 自动签到最多同时使用 2 个 Context，并为交互登录单独保留 1 个租约。
AUTOSIGN_BROWSER_AUTOMATION_CAPACITY=2
AUTOSIGN_BROWSER_INTERACTIVE_CAPACITY=1
# 可选的 Playwright HTTP/SOCKS 代理；可用逗号分隔的 bypass 让指定域名直连。
AUTOSIGN_BROWSER_PROXY_SERVER=
AUTOSIGN_BROWSER_PROXY_BYPASS=
AUTOSIGN_SCHEDULER_POLL_SECONDS=15
AUTOSIGN_BACKUP_ENABLED=false
AUTOSIGN_BACKUP_DAILY_TIME=03:30
AUTOSIGN_BACKUP_TIMEZONE=Asia/Shanghai
AUTOSIGN_BACKUP_RETENTION_COUNT=7
AUTOSIGN_BACKUP_PASSWORD=
# 仅当 AutoSign 已由 HTTPS 反向代理访问时改为 true。
AUTOSIGN_AUTH_SECURE_COOKIE=false
# 使用 `python -m autosign init-key` 生成，不要提交真实值。
AUTOSIGN_MASTER_KEY=
