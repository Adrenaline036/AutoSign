AUTOSIGN_ENVIRONMENT=development
AUTOSIGN_HOST=0.0.0.0
AUTOSIGN_PORT=8000
AUTOSIGN_DATA_DIR=./data
AUTOSIGN_LOG_LEVEL=INFO
# Docker 通过 Xvfb 运行有界面 Chromium；本地开发可保留 true。
AUTOSIGN_BROWSER_HEADLESS=true
AUTOSIGN_SCHEDULER_POLL_SECONDS=15
AUTOSIGN_BACKUP_ENABLED=false
AUTOSIGN_BACKUP_DAILY_TIME=03:30
AUTOSIGN_BACKUP_TIMEZONE=Asia/Shanghai
AUTOSIGN_BACKUP_RETENTION_COUNT=7
AUTOSIGN_BACKUP_PASSWORD=
# 仅当 AutoSign 已由 HTTPS 反向代理访问时改为 true。
AUTOSIGN_AUTH_SECURE_COOKIE=false
# 使用 `python -m autosign init-key` 生成，不要提交真实值。
AUTOSIGN_MASTER_KEY=
